# .bashrc -- machine-local entry point for the shared IPRC configuration

if [ -r /etc/bashrc ]; then
  . /etc/bashrc
fi

__iprc_shared_bashrc=/nfs_global/S/wenzhiyang/dotfiles/shell/bashrc
if [ -r "$__iprc_shared_bashrc" ]; then
  . "$__iprc_shared_bashrc"
else
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) PATH="$HOME/.local/bin:$PATH" ;;
  esac
  case ":$PATH:" in
    *":$HOME/bin:"*) ;;
    *) PATH="$HOME/bin:$PATH" ;;
  esac
  export PATH
  if [[ $- == *i* ]]; then
    printf 'warning: shared shell configuration is unavailable: %s\n' "$__iprc_shared_bashrc" >&2
  fi
fi
unset __iprc_shared_bashrc
