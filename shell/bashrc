# Shared interactive Bash configuration for the IPRC login nodes.
# Keep machine-local secrets, history, caches and editor/server state out of here.

case $- in
  *i*) ;;
  *) return ;;
esac

if [ -n "${IPRC_SHARED_BASHRC_LOADED:-}" ]; then
  return
fi
IPRC_SHARED_BASHRC_LOADED=1

export IPRC_SHARED_ROOT="${IPRC_SHARED_ROOT:-/nfs_global/S/wenzhiyang}"
export IPRC_CONDA_ROOT="${IPRC_CONDA_ROOT:-$IPRC_SHARED_ROOT/runtime/conda-common}"
export IPRC_COMMON_RUNTIME="${IPRC_COMMON_RUNTIME:-$IPRC_SHARED_ROOT/runtime/common}"

__iprc_path_prepend() {
  [ -d "$1" ] || return
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}

__iprc_arch="$(uname -m 2>/dev/null || printf unknown)"
__iprc_platform=""
if [ -r /etc/os-release ]; then
  __iprc_platform="$(
    . /etc/os-release
    printf '%s%s-%s' "$ID" "${VERSION_ID%%.*}" "$__iprc_arch"
  )"
fi

__iprc_path_prepend "$HOME/bin"
__iprc_path_prepend "$HOME/.local/bin"
__iprc_path_prepend "$IPRC_COMMON_RUNTIME/bin"
[ -n "$__iprc_platform" ] &&
  __iprc_path_prepend "$IPRC_SHARED_ROOT/runtime/platform/$__iprc_platform/bin"
export PATH
unset -f __iprc_path_prepend
unset __iprc_arch __iprc_platform

if [ -x "$IPRC_CONDA_ROOT/bin/conda" ]; then
  __iprc_conda_setup="$("$IPRC_CONDA_ROOT/bin/conda" shell.bash hook 2>/dev/null)"
  if [ $? -eq 0 ]; then
    eval "$__iprc_conda_setup"
  elif [ -r "$IPRC_CONDA_ROOT/etc/profile.d/conda.sh" ]; then
    . "$IPRC_CONDA_ROOT/etc/profile.d/conda.sh"
  else
    export PATH="$IPRC_CONDA_ROOT/bin:$PATH"
  fi
  unset __iprc_conda_setup

  if [ "${IPRC_CONDA_AUTO_ACTIVATE:-1}" = 1 ] &&
     [ -d "$IPRC_CONDA_ROOT/envs/test" ] &&
     [ "${CONDA_DEFAULT_ENV:-}" != test ]; then
    conda activate test
  fi
fi

# Rocky's /etc/profile.d/which2.sh prints the Conda shell function body.
# Keep Conda activation support while making `which conda` report its executable.
unalias which 2>/dev/null || true
function which {
  if [ "$#" -eq 1 ] && [ "$1" = conda ] && [ -n "${CONDA_EXE:-}" ]; then
    printf '%s\n' "$CONDA_EXE"
    return 0
  fi
  /usr/bin/which "$@"
}

alias sq='squeue -o "%.10i %.15P %.15j %.15u %.2t %.10M %.6D %R"'
alias zj='zellij'

__iprc_hostname="$(hostname -s 2>/dev/null || hostname)"
if [ "$__iprc_hostname" != RockyOS8-Login0 ]; then
  alias rocky='ssh wenzhiyang@RockyOS8-Login0'
fi

if [ -r /tools/module_env.sh ]; then
  . /tools/module_env.sh >/dev/null 2>&1
  if type module >/dev/null 2>&1; then
    module load slurm-tools >/dev/null 2>&1 || true
    module load cluster-tools >/dev/null 2>&1 || true
  fi
fi

if [[ "$__iprc_hostname" =~ ^eda-0[0-3]$ ]]; then
  __iprc_eda_num="${__iprc_hostname#eda-}"
  __iprc_eda_script="/eda-tools/eda-software/synopsys/source-scripts/bash_eda${__iprc_eda_num}"
  [ -r "$__iprc_eda_script" ] && . "$__iprc_eda_script"
  export DESIGNWARE_HOME=/eda-tools/eda-software/synopsys/DESIGNWARE/O-2018.09
elif [[ "$__iprc_hostname" =~ ^eda-0[4-9]$ || "$__iprc_hostname" = eda-10 ]]; then
  __iprc_eda_num="${__iprc_hostname#eda-}"
  __iprc_eda_script="/centos7/eda-tools/eda-software/synopsys/source-scripts/bash_eda${__iprc_eda_num}"
  [ -r "$__iprc_eda_script" ] && . "$__iprc_eda_script"
  export DESIGNWARE_HOME=/centos7/eda-tools/eda-software/synopsys/DESIGNWARE/O-2018.09
fi
unset __iprc_hostname __iprc_eda_num __iprc_eda_script

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi
